# ============================================================
# SILVERLINE RESORT — Environment Variables Template
# Copy this to .env (never commit .env)
# ============================================================

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_SESSION_DURATION=8h

# --- Supabase (PostgreSQL) ---
# Get from: Supabase Dashboard → Project Settings → API
# Project URL (safe to expose — controls which project):
SUPABASE_URL=
# Service Role Key (SERVER-SIDE ONLY — bypasses all RLS — NEVER put in frontend code):
SUPABASE_SERVICE_ROLE_KEY=
# NOTE: SUPABASE_ANON_KEY is NOT used — do not add it.

# --- Legacy database (no longer used) ---
# DATABASE_URL was for the old JSON-file prototype. The Supabase SDK uses
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY instead.
# DATABASE_URL=

# --- Payment Gateway ---
# Provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
# Razorpay (recommended for INR):
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
# Stripe (alternative):
PAYMENT_STRIPE_PUBLIC_KEY=
PAYMENT_STRIPE_SECRET_KEY=

# --- Email Service ---
# Provider: mock | sendgrid | resend | nodemailer
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=reservations@silverlineresort.in
EMAIL_REPLY_TO=info@silverlineresort.in

# --- OTA / Channel Manager ---
# Provider: mock | siteminder | cloudbeds
OTA_PROVIDER=mock
OTA_API_KEY=
OTA_PROPERTY_ID=

# --- Hotel Configuration ---
HOTEL_NAME=Silverline Resort
HOTEL_PHONE=+918638479919
HOTEL_TAX_RATE=0.12
HOTEL_CURRENCY=INR

# --- Environment ---
NODE_ENV=development

# --- Admin Initialization ---
# Admin users are seeded directly into the Supabase users table.
# See: supabase/migrations/001_initial_schema.sql Section 14.
# Default credentials (CHANGE BEFORE GOING LIVE):
#   admin@silverlineresort.in / SilverlineAdmin2026!
#   staff@silverlineresort.in / SilverlineStaff2026!
