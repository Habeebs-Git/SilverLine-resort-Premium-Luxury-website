# ============================================================
# SILVERLINE RESORT — Environment Variables Template
# Copy this to .env (never commit .env)
# ============================================================

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_SESSION_DURATION=8h

# --- Database ---
# For prototype: leave empty (uses JSON file storage in /data/)
# For production: PostgreSQL connection string (e.g., Vercel Postgres, Supabase)
DATABASE_URL=

# --- Payment Gateway ---
# Provider: mock | razorpay | stripe
PAYMENT_PROVIDER=mock
# Razorpay (recommended for INR):
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
# Stripe (alternative):
PAYMENT_STRIPE_PUBLIC_KEY=
PAYMENT_STRIPE_SECRET_KEY=

# --- Email Service ---
# Provider: mock | sendgrid | resend | nodemailer
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=reservations@silverlineresort.in
EMAIL_REPLY_TO=info@silverlineresort.in

# --- OTA / Channel Manager ---
# Provider: mock | siteminder | cloudbeds
OTA_PROVIDER=mock
OTA_API_KEY=
OTA_PROPERTY_ID=

# --- Hotel Configuration ---
HOTEL_NAME=Silverline Resort
HOTEL_PHONE=+918638479919
HOTEL_TAX_RATE=0.12
HOTEL_CURRENCY=INR

# --- Environment ---
NODE_ENV=development

# --- Admin Initialization ---
# Admin users are stored in data/users.json (gitignored).
# To initialize admin accounts, run: node scripts/seed.js
# This generates data/users.json with bcrypt-hashed credentials.
# IMPORTANT: Change the default credentials in seed.js before running in production.
# data/users.json must exist before the admin login API will work.
