{
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/privacy-policy", "destination": "/pages/privacy-policy.html" },
    { "source": "/terms", "destination": "/pages/terms-and-conditions.html" },
    { "source": "/booking", "destination": "/pages/booking.html" },
    { "source": "/booking-confirmation", "destination": "/pages/booking-confirmation.html" },
    { "source": "/admin", "destination": "/pages/admin/login.html" },
    { "source": "/admin/login", "destination": "/pages/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/pages/admin/dashboard.html" },
    { "source": "/admin/reservations", "destination": "/pages/admin/reservations.html" },
    { "source": "/admin/rooms", "destination": "/pages/admin/rooms.html" },
    { "source": "/admin/guests", "destination": "/pages/admin/guests.html" },
    { "source": "/admin/calendar", "destination": "/pages/admin/calendar.html" },
    { "source": "/admin/settings", "destination": "/pages/admin/settings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.moda.app https://fonts.googleapis.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.moda.app; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://api.moda.app https://www.google.com; frame-src https://www.google.com https://checkout.razorpay.com https://api.razorpay.com; connect-src 'self' https://cdn.moda.app https://api.razorpay.com https://checkout.razorpay.com; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/pages/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
